---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/og-default.png',
  canonical,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <!-- Umami analytics -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="c5cdac05-701f-4055-b623-d270eda46f37"></script>

    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <div id="lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image lightbox">
      <button id="lb-close" aria-label="Close lightbox">×</button>
      <img id="lb-img" src="" alt="" />
    </div>
  </body>
</html>

<style is:global>
  #lb {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    padding: 24px;
  }
  #lb.open {
    display: flex;
    animation: lb-fade 0.18s ease;
  }
  #lb-img {
    max-width: min(90vw, 1200px);
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
    cursor: default;
  }
  #lb-close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 10px;
    font-family: var(--font-sans);
    transition: color 0.15s;
  }
  #lb-close:hover { color: #fff; }
  @keyframes lb-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .prose img { cursor: zoom-in; }
</style>

<script>
  const lb    = document.getElementById('lb') as HTMLElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;

  function openLb(src: string, alt: string) {
    lbImg.src = src;
    lbImg.alt = alt;
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLb() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lbImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const img = (e.target as Element).closest('.prose img') as HTMLImageElement | null;
    if (img) { e.preventDefault(); openLb(img.src, img.alt); }
  });

  lb.addEventListener('click', (e) => { if (e.target !== lbImg) closeLb(); });

  document.getElementById('lb-close')!.addEventListener('click', closeLb);

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });
</script>
